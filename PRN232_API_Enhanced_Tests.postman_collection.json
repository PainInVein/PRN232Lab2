{
    "info": {
        "name": "PRN232 API - Enhanced Tests with Schema Validation",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{authToken}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000"
        },
        {
            "key": "authToken",
            "value": ""
        },
        {
            "key": "createdCategoryId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login - Success",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                                    "",
                                    "const schema = {",
                                    "    type: 'object',",
                                    "    required: ['message', 'isSuccess', 'data'],",
                                    "    properties: {",
                                    "        message: { type: 'string' },",
                                    "        isSuccess: { type: 'boolean' },",
                                    "        data: { type: 'string' }",
                                    "    }",
                                    "};",
                                    "",
                                    "pm.test('Response matches schema', () => {",
                                    "    pm.response.to.have.jsonSchema(schema);",
                                    "});",
                                    "",
                                    "pm.test('Login successful', () => {",
                                    "    const res = pm.response.json();",
                                    "    pm.expect(res.isSuccess).to.be.true;",
                                    "    pm.collectionVariables.set('authToken', res.data);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\": \"admin@example.com\", \"password\": \"Admin@123\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/auth/login"
                    }
                },
                {
                    "name": "Login - Invalid Credentials",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 401', () => pm.response.to.have.status(401));",
                                    "",
                                    "const schema = {",
                                    "    type: 'object',",
                                    "    required: ['message', 'isSuccess', 'errors'],",
                                    "    properties: {",
                                    "        isSuccess: { type: 'boolean' },",
                                    "        errors: { type: 'string' }",
                                    "    }",
                                    "};",
                                    "",
                                    "pm.test('Response matches error schema', () => {",
                                    "    pm.response.to.have.jsonSchema(schema);",
                                    "    const res = pm.response.json();",
                                    "    pm.expect(res.isSuccess).to.be.false;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\": \"wrong@test.com\", \"password\": \"wrong\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/auth/login"
                    }
                },
                {
                    "name": "Login - Invalid Request",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 400 or 401', () => pm.expect(pm.response.code).to.be.oneOf([400, 401]));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\": \"\", \"password\": \"\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/auth/login"
                    }
                }
            ]
        },
